<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mpv="clr-namespace:Auralith.Playback.Mpv;assembly=Auralith.Playback.Mpv"
        x:Class="Auralith.App.MainWindow"
        Title="Auralith"
        Width="1100"
        Height="700"
        MinWidth="780"
        MinHeight="460"
        Background="#08090B">
  <Grid RowDefinitions="Auto,*">
    <Border Background="#111318" Padding="10,8">
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
        <Button x:Name="OpenButton"
                Content="Open"
                Click="OpenButton_Click"
                MinWidth="86" />
        <TextBlock x:Name="MediaPathText"
                   Grid.Column="1"
                   Foreground="#C6CAD3"
                   VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis"
                   Text="No media loaded" />
      </Grid>
    </Border>

    <Grid Grid.Row="1"
          x:Name="VideoSurface"
          Background="#050608"
          PointerMoved="VideoSurface_PointerMoved"
          PointerPressed="VideoSurface_PointerPressed"
          DoubleTapped="VideoSurface_DoubleTapped">
      <mpv:MpvPlaybackSurface x:Name="PlaybackSurface"
                              Ready="PlaybackSurface_Ready"
                              Failed="PlaybackSurface_Failed" />

      <Border x:Name="Overlay"
              VerticalAlignment="Bottom"
              Background="#B0000000"
              Padding="14,12"
              PointerEntered="Overlay_PointerEntered"
              PointerExited="Overlay_PointerExited">
        <Grid RowDefinitions="Auto,Auto" RowSpacing="10">
          <Slider x:Name="TimelineSlider"
                  Minimum="0"
                  Maximum="1"
                  Value="0"
                  PointerEntered="TimelineSlider_PointerEntered"
                  PointerExited="TimelineSlider_PointerExited"
                  PointerPressed="TimelineSlider_PointerPressed"
                  PointerReleased="TimelineSlider_PointerReleased"
                  PropertyChanged="TimelineSlider_PropertyChanged" />

          <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="12">
            <Button x:Name="PlayPauseButton"
                    Content="Play"
                    Click="PlayPauseButton_Click"
                    MinWidth="72" />
            <Button x:Name="StopButton"
                    Grid.Column="1"
                    Content="Stop"
                    Click="StopButton_Click"
                    MinWidth="72" />
            <TextBlock x:Name="TimeText"
                       Grid.Column="2"
                       Foreground="#E7E9EE"
                       VerticalAlignment="Center"
                       Text="00:00 / 00:00" />
            <TextBlock Grid.Column="3"
                       Foreground="#AEB4C0"
                       VerticalAlignment="Center"
                       Text="Volume" />
            <Slider x:Name="VolumeSlider"
                    Grid.Column="4"
                    Width="150"
                    Minimum="0"
                    Maximum="100"
                    Value="70"
                    PropertyChanged="VolumeSlider_PropertyChanged" />
          </Grid>
        </Grid>
      </Border>

      <Border x:Name="ContextMenuNotice"
              HorizontalAlignment="Right"
              VerticalAlignment="Top"
              Margin="16"
              Padding="10,6"
              CornerRadius="4"
              Background="#D01B1F27"
              IsVisible="False">
        <TextBlock Foreground="#E7E9EE" Text="Context menu placeholder" />
      </Border>
    </Grid>
  </Grid>
</Window>
